<Page
    x:Class="TouchChanX.UWP.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TouchChanX.UWP"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TouchChanPanelBackgroundBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="TouchChanPanelBorderBrush" Color="#DADADA" />
                    <SolidColorBrush x:Key="TouchChanTileBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TouchChanPanelBackgroundBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="TouchChanPanelBorderBrush" Color="#DADADA" />
                    <SolidColorBrush x:Key="TouchChanTileBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TouchChanPanelBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="TouchChanPanelBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="TouchChanTileBackgroundBrush" Color="#2B2B2B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <Grid Margin="32 24 32 32">
            <StackPanel Spacing="24">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="游戏启动" />
                        <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="选择或拖入游戏主程序，TouchChanX 会通过 touchchanx 协议启动。" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind AddGameCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="添加游戏" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border
                    x:Name="DropArea"
                    MinHeight="220"
                    Padding="20"
                    AllowDrop="True"
                    Background="{ThemeResource TouchChanPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource TouchChanPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="{x:Bind EmptyStateVisibility.Value, Mode=OneWay}">
                            <FontIcon HorizontalAlignment="Center" FontSize="36" Glyph="&#xE7FC;" />
                            <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="拖入 .exe 或 .lnk 添加游戏" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Text="添加后会显示为竖向游戏列表。"
                                TextAlignment="Center" />
                        </StackPanel>

                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <CommandBar
                                Background="Transparent"
                                DefaultLabelPosition="Right"
                                Visibility="{x:Bind SelectedGameActionsVisibility.Value, Mode=OneWay}">
                                <CommandBar.Content>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind SelectedGameName.Value, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </CommandBar.Content>
                                <AppBarButton Command="{x:Bind LaunchSelectedGameCommand}" Icon="Play" IsEnabled="{x:Bind CanLaunchSelectedGame.Value, Mode=OneWay}" Label="启动" />
                                <AppBarButton Command="{x:Bind RenameSelectedGameCommand}" Icon="Edit" Label="重命名" />
                                <AppBarButton Command="{x:Bind RemoveSelectedGameCommand}" Icon="Delete" Label="移除" />
                            </CommandBar>

                            <GridView x:Name="GameList"
                                Grid.Row="1"
                                ItemsSource="{x:Bind GameItems}"
                                MaxHeight="520"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollMode="Enabled"
                                SelectionMode="Single"
                                Visibility="{x:Bind GameListVisibility.Value, Mode=OneWay}">
                                <!--  保留增加删除动画的同时，移除重排动画，但我们不使用，保持默认  -->
                                <!--<GridView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                    </TransitionCollection>
                                </GridView.ItemContainerTransitions>-->
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Margin" Value="0 0 12 12" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:GameEntry">
                                        <Grid
                                            Width="152"
                                            Height="136"
                                            ToolTipService.ToolTip="{x:Bind Path}">
                                            <Border
                                                Padding="12"
                                                Background="{ThemeResource TouchChanTileBackgroundBrush}"
                                                BorderThickness="0"
                                                CornerRadius="4">
                                                <StackPanel VerticalAlignment="Center" Spacing="10">
                                                    <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                                        <Image
                                                            Width="48"
                                                            Height="48"
                                                            Source="{x:Bind Icon.Value, Mode=OneWay}"
                                                            Stretch="Uniform"
                                                            Visibility="{x:Bind IconVisibility.Value, Mode=OneWay}" />
                                                        <FontIcon
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="32"
                                                            Glyph="&#xE7FC;"
                                                            Visibility="{x:Bind FallbackIconVisibility.Value, Mode=OneWay}" />
                                                    </Grid>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        MaxLines="2"
                                                        Text="{x:Bind Name.Value, Mode=OneWay}"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>

                                            <Border
                                                BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                                BorderThickness="2"
                                                CornerRadius="0"
                                                IsHitTestVisible="False"
                                                Opacity="0.55"
                                                Visibility="{x:Bind SelectedVisualVisibility.Value, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
