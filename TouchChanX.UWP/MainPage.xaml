<Page
    x:Class="TouchChanX.UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:TouchChanX.UWP"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TouchChanPanelBackgroundBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="TouchChanPanelBorderBrush" Color="#DADADA" />
                    <SolidColorBrush x:Key="TouchChanTileBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TouchChanPanelBackgroundBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="TouchChanPanelBorderBrush" Color="#DADADA" />
                    <SolidColorBrush x:Key="TouchChanTileBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TouchChanPanelBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="TouchChanPanelBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="TouchChanTileBackgroundBrush" Color="#2B2B2B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar"
            Height="48"
            VerticalAlignment="Top"
            Background="Transparent"
            Canvas.ZIndex="1"
            IsHitTestVisible="True">
            <TextBlock x:Name="AppTitle"
                Margin="24 0 0 0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="触控酱" />
        </Border>

        <muxc:NavigationView x:Name="AppNav"
            Grid.Row="1"
            Header="主页"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="AppNav_SelectionChanged"
            Style="{StaticResource RailNavigationViewStyle}">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="主页" IsSelected="True" Tag="home">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="设置" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="关于" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <ScrollViewer>
                <Grid Margin="32 24 32 32">
                    <StackPanel x:Name="HomePage"  Spacing="24">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="游戏启动" />
                                <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="选择或拖入游戏主程序，TouchChanX 会通过 touchchanx 协议启动。" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="AddGame_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock Text="添加游戏" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border
                            MinHeight="220"
                            Padding="20"
                            AllowDrop="True"
                            Background="{ThemeResource TouchChanPanelBackgroundBrush}"
                            BorderBrush="{ThemeResource TouchChanPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            DragOver="DropArea_DragOver"
                            Drop="DropArea_Drop">
                            <Grid>
                                <StackPanel x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                                    <FontIcon HorizontalAlignment="Center" FontSize="36" Glyph="&#xE7FC;" />
                                    <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="拖入 .exe 或 .lnk 添加游戏" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Text="添加后会显示为竖向游戏列表。"
                                        TextAlignment="Center" />
                                </StackPanel>

                                <Grid RowSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <CommandBar x:Name="SelectedGameActions"
                                        Background="Transparent"
                                        DefaultLabelPosition="Right"
                                        Visibility="Collapsed">
                                        <CommandBar.Content>
                                            <TextBlock x:Name="SelectedGameName"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </CommandBar.Content>
                                        <AppBarButton Icon="Play" Label="启动" Click="LaunchSelectedGame_Click" />
                                        <AppBarButton Icon="Edit" Label="重命名" Click="RenameSelectedGame_Click" />
                                        <AppBarButton Icon="Delete" Label="移除" Click="RemoveSelectedGame_Click" />
                                    </CommandBar>

                                    <GridView x:Name="GameList"
                                        Grid.Row="1"
                                        MaxHeight="520"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollMode="Enabled"
                                        SelectionChanged="GameList_SelectionChanged"
                                        SelectionMode="Single"
                                        Visibility="Collapsed">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="0 0 12 12" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:GameEntry">
                                                <Border
                                                    Width="152"
                                                    Height="136"
                                                    Padding="12"
                                                    Background="{ThemeResource TouchChanTileBackgroundBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    DoubleTapped="GameItem_DoubleTapped"
                                                    ToolTipService.ToolTip="{x:Bind Path}">
                                                    <Border.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Click="LaunchGame_Click" Tag="{x:Bind}" Text="启动">
                                                                <MenuFlyoutItem.Icon>
                                                                    <SymbolIcon Symbol="Play" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Click="RenameGame_Click" Tag="{x:Bind}" Text="重命名">
                                                                <MenuFlyoutItem.Icon>
                                                                    <SymbolIcon Symbol="Edit" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Click="RemoveGame_Click" Tag="{x:Bind}" Text="移除">
                                                                <MenuFlyoutItem.Icon>
                                                                    <SymbolIcon Symbol="Delete" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Border.ContextFlyout>
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Center" Spacing="10">
                                                            <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                                                <Image
                                                                    Width="48"
                                                                    Height="48"
                                                                    Source="{x:Bind Icon, Mode=OneWay}"
                                                                    Stretch="Uniform"
                                                                    Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                                                <FontIcon
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="32"
                                                                    Glyph="&#xE7FC;"
                                                                    Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}" />
                                                            </Grid>
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                MaxLines="2"
                                                                Text="{x:Bind Name, Mode=OneWay}"
                                                                TextAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="Collapsed" x:Name="SettingsPage"  Spacing="16">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="设置" />
                        <ct:SettingsCard Description="仅占位 UI，暂未连接 ShellMenuHandler 业务逻辑。" Header="在上下文菜单中显示 TouchChanX">
                            <ct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </ct:SettingsCard.HeaderIcon>
                            <ToggleSwitch IsOn="True" OffContent="关闭" OnContent="开启" />
                        </ct:SettingsCard>
                    </StackPanel>

                    <StackPanel Visibility="Collapsed" x:Name="AboutPage"  Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Image Width="64" Height="64" Source="ms-appx:///Images/StoreLogo.png" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="TouchChanX" />
                                <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="轻触游戏窗口的 Touch 菜单。" />
                            </StackPanel>
                        </StackPanel>

                        <ct:SettingsCard
                            Click="RateInStore_Click"
                            Description="打开 Microsoft Store 评分入口。"
                            Header="为 TouchChanX 评分"
                            IsClickEnabled="True">
                            <ct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8D4;" />
                            </ct:SettingsCard.HeaderIcon>
                            <ct:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </ct:SettingsCard.ActionIcon>
                        </ct:SettingsCard>

                        <ct:SettingsCard
                            Click="OpenSource_Click"
                            Description="查看源码、许可和 issue。"
                            Header="开源项目"
                            IsClickEnabled="True">
                            <ct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE943;" />
                            </ct:SettingsCard.HeaderIcon>
                            <ct:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </ct:SettingsCard.ActionIcon>
                        </ct:SettingsCard>

                        <ct:SettingsCard Description="QQ群链接待补充。" Header="QQ 交流群" IsEnabled="False">
                            <ct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8F2;" />
                            </ct:SettingsCard.HeaderIcon>
                        </ct:SettingsCard>

                        <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="TouchChanX 是开源项目，遵循仓库中的开源许可。" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </muxc:NavigationView>
    </Grid>
</Page>
