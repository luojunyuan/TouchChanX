<Page x:Class="TouchChanX.UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:TouchChanX.UWP"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TouchChanPanelBackgroundBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="TouchChanPanelBorderBrush" Color="#DADADA" />
                    <SolidColorBrush x:Key="TouchChanTileBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TouchChanPanelBackgroundBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="TouchChanPanelBorderBrush" Color="#DADADA" />
                    <SolidColorBrush x:Key="TouchChanTileBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TouchChanPanelBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="TouchChanPanelBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="TouchChanTileBackgroundBrush" Color="#2B2B2B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar"
            Height="48"
            VerticalAlignment="Top"
            Background="Transparent"
            Canvas.ZIndex="1"
            IsHitTestVisible="True">
            <TextBlock x:Name="AppTitle"
                Margin="24 0 0 0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="TachiChan" />
        </Border>

        <muxc:NavigationView x:Name="AppNav"
            Grid.Row="1"
            Header="主页"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="AppNav_SelectionChanged"
            Style="{StaticResource RailNavigationViewStyle}">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="主页" IsSelected="True" Tag="home">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="设置" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="关于" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Grid Padding="32 24 32 32">
                <ScrollViewer x:Name="HomePage">
                    <StackPanel MaxWidth="980" Spacing="24">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="游戏启动" />
                                <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="选择或拖入游戏主程序，TouchChanX 会通过 touchchanx 协议启动。" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="AddGame_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock Text="添加游戏" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border
                            MinHeight="220"
                            Padding="20"
                            AllowDrop="True"
                            Background="{ThemeResource TouchChanPanelBackgroundBrush}"
                            BorderBrush="{ThemeResource TouchChanPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            DragOver="DropArea_DragOver"
                            Drop="DropArea_Drop">
                            <Grid>
                                <StackPanel x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                                    <FontIcon HorizontalAlignment="Center" FontSize="36" Glyph="&#xE7FC;" />
                                    <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="拖入 .exe 或 .lnk 添加游戏" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Text="添加后会显示为横向图标列表。"
                                        TextAlignment="Center" />
                                </StackPanel>

                                <ListView x:Name="GameList"
                                    IsItemClickEnabled="True"
                                    ItemClick="GameList_ItemClick"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollMode="Enabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionMode="None"
                                    Visibility="Collapsed">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Margin" Value="0 0 12 0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:GameEntry">
                                            <Border
                                                Width="152"
                                                Height="128"
                                                Padding="12"
                                                Background="{ThemeResource TouchChanTileBackgroundBrush}"
                                                CornerRadius="8"
                                                ToolTipService.ToolTip="{x:Bind Path}">
                                                <StackPanel VerticalAlignment="Center" Spacing="10">
                                                    <FontIcon HorizontalAlignment="Center" FontSize="32" Glyph="&#xE7FC;" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        MaxLines="2"
                                                        Text="{x:Bind Name}"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" Spacing="16">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="设置" />
                        <ct:SettingsCard Description="仅占位 UI，暂未连接 ShellMenuHandler 业务逻辑。" Header="在上下文菜单中显示 TouchChanX">
                            <ct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </ct:SettingsCard.HeaderIcon>
                            <ToggleSwitch IsOn="True" OffContent="关闭" OnContent="开启" />
                        </ct:SettingsCard>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Image Width="64" Height="64" Source="ms-appx:///Images/StoreLogo.png" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="TouchChanX" />
                                <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="轻触游戏窗口的 Touch 菜单。" />
                            </StackPanel>
                        </StackPanel>

                        <ct:SettingsCard
                            Click="RateInStore_Click"
                            Description="打开 Microsoft Store 评分入口。"
                            Header="为 TouchChanX 评分"
                            IsClickEnabled="True">
                            <ct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8D4;" />
                            </ct:SettingsCard.HeaderIcon>
                            <ct:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </ct:SettingsCard.ActionIcon>
                        </ct:SettingsCard>

                        <ct:SettingsCard
                            Click="OpenSource_Click"
                            Description="查看源码、许可和 issue。"
                            Header="开源项目"
                            IsClickEnabled="True">
                            <ct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE943;" />
                            </ct:SettingsCard.HeaderIcon>
                            <ct:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </ct:SettingsCard.ActionIcon>
                        </ct:SettingsCard>

                        <ct:SettingsCard Description="QQ群链接待补充。" Header="QQ 交流群" IsEnabled="False">
                            <ct:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8F2;" />
                            </ct:SettingsCard.HeaderIcon>
                        </ct:SettingsCard>

                        <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="TouchChanX 是开源项目，遵循仓库中的开源许可。" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Page>
