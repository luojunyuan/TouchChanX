<ContentDialog
    x:Class="TouchChanX.UWP.ExternalLauncherTestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TouchChanX.UWP"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind CanStart.Value, Mode=OneWay}"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    PrimaryButtonText="启动测试"
    SecondaryButtonText="取消"
    Title="测试启动器"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="local:ExternalLauncherTestDialog" />
        <DataTemplate x:Key="GameItemTemplate" x:DataType="local:GameEntry">
            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <ComboBox
                Header="主页已有游戏"
                HorizontalAlignment="Stretch"
                ItemTemplate="{StaticResource GameItemTemplate}"
                ItemsSource="{x:Bind Games}"
                SelectedItem="{x:Bind SelectedGame.Value, Mode=TwoWay}" />
            <Button
                x:Name="BrowseTestGameButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" />
                    <TextBlock Text="选择其他游戏…" />
                </StackPanel>
            </Button>
            <TextBox
                Header="测试游戏路径"
                IsReadOnly="True"
                PlaceholderText="请选择游戏主程序"
                Text="{x:Bind TestGamePath.Value, Mode=OneWay}" />
            <muxc:InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="测试会实际启动游戏。"
                Severity="Warning" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
