    <PackageVersion Include="Islands.UI.Xaml" Version="0.1.2" />
    <PackageVersion Include="Kumo.Uwp.NavigationView.RailStyle" Version="1.1.2" />
    <PackageVersion Include="LightResults" Version="10.0.4" />
    <PackageVersion Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.298" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260610101" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
