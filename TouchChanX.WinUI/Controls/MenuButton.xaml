<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="TouchChanX.WinUI.Controls.MenuButton" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TouchChanX.WinUI.Controls"
    d:DataContext="{d:DesignInstance Type=local:MenuButton}"
    Foreground="White"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="NormalBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6FC4F1" />
        <SolidColorBrush x:Key="PressedBrush" Color="#A8DCF6" />
        <SolidColorBrush x:Key="DisabledBrush" Color="#707070" />
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Padding="4" Background="Transparent">
        <StackPanel
            MaxWidth="88"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="5">
            <Viewbox Width="28" Height="28">
                <SymbolIcon x:Name="ItemIcon" Symbol="{x:Bind Symbol, Mode=OneWay}" />
            </Viewbox>

            <TextBlock x:Name="ItemText"
                HorizontalAlignment="Center"
                FontSize="12"
                MaxLines="2"
                Text="{x:Bind Text, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Grid>
</UserControl>
