<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="TouchChanX.WinUI.Controls.MessageFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TouchChanX.WinUI.Controls"
    d:DataContext="{d:DesignInstance Type=local:MessageFlyoutControl}"
    IsHitTestVisible="False"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Grid>
        <Border x:Name="FlyoutBorder"
            MinWidth="148"
            MinHeight="48"
            Margin="0,20,0,0"
            Padding="28,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#2A2A2A"
            BorderBrush="#35FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Opacity="0">
            <TextBlock x:Name="MessageText"
                VerticalAlignment="Center"
                Text="{x:Bind Strings.MouseClick}"
                TextAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
