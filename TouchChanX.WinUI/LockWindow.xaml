<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="TouchChanX.WinUI.LockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TouchChanX Lock"
    mc:Ignorable="d">

    <Grid Background="#B8000000">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="16">
            <Button x:Name="FreezeButton"
                MinWidth="160"
                MinHeight="72"
                Padding="24,12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="24" Glyph="&#xE769;" />
                    <TextBlock FontSize="20" Text="冻结" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="UnlockButton"
                MinWidth="160"
                MinHeight="72"
                Padding="24,12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="24" Glyph="&#xE785;" />
                    <TextBlock FontSize="20" Text="解锁" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="CloseWindowButton"
                MinWidth="160"
                MinHeight="72"
                Padding="24,12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="24" Glyph="&#xE711;" />
                    <TextBlock FontSize="20" Text="取消" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
